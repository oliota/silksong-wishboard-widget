{
  "name": "silksong-wishboard-widget",
  "private": true,
  "scripts": {
    "install": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"Get-ChildItem -Recurse | Unblock-File\"",
    "run": "powershell.exe -NoProfile -ExecutionPolicy Bypass -STA -File src/widget.ps1",
    "test": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"Get-ChildItem src -Filter *.json -Recurse | ForEach-Object { Get-Content $_.FullName -Raw | ConvertFrom-Json | Out-Null }\"",
    "build": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"Compress-Archive -Path 'Desktop Wish Board.vbs','src','README.md','ARCHITECTURE.md','package.json' -DestinationPath silksong-wishboard-widget.zip -Force\"",
    "lint": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"$errors=$null; Get-ChildItem src -Filter *.ps1 -Recurse | ForEach-Object { [System.Management.Automation.Language.Parser]::ParseFile($_.FullName,[ref]$null,[ref]$errors) | Out-Null; if($errors){$errors; exit 1} }\"",
    "format": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"Get-ChildItem src -Filter *.ps1 -Recurse | ForEach-Object { $content=Get-Content $_.FullName -Raw; [IO.File]::WriteAllText($_.FullName,$content.TrimEnd()+[Environment]::NewLine,[Text.UTF8Encoding]::new($false)) }\"",
    "debug": "powershell.exe -NoProfile -ExecutionPolicy Bypass -STA -File src/widget.ps1",
    "help": "npm run",
    "list": "powershell.exe -NoProfile -Command \"Get-ChildItem src -Recurse -File | Select-Object FullName\"",
    "status": "git status --short",
    "logs": "git log -10 --oneline"
  },
  "scripts-fake": {
    "----": "runtime",
    "-----": "quality",
    "------": "discovery"
  }
}
